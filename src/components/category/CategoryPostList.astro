---
import PageIntro from '@components/common/PageIntro.astro';
import PostYears from '@components/common/PostYears.astro';
import { buildCategoryPath, type Category, translateCategoryName } from '@lib/content';
import { postsInCategoryPath } from '@lib/content/index-categories';
import type { BlogPost } from 'types/blog';
import { localizedPath, t } from '@/i18n';

interface Props {
  category: Category | null;
  path: string[];
  allPosts: BlogPost[];
  locale: string;
}
const { category, path, allPosts, locale } = Astro.props;
const posts = postsInCategoryPath(allPosts, path);
const breadcrumbs = [
  { label: t(locale, 'nav.categories'), href: localizedPath('/categories', locale) },
  ...path.map((name, index) => ({
    label: translateCategoryName(name, locale),
    href: index === path.length - 1 ? undefined : localizedPath(buildCategoryPath(path.slice(0, index + 1)), locale),
  })),
];
---
<div class="index-surface shadow-box">
  <PageIntro stats={[{ value: posts.length, label: t(locale, 'index.posts') }]} breadcrumbs={breadcrumbs}>
    {category?.children?.length && <nav class="index-tabs" slot="tools" aria-label={t(locale, 'category.filter')}>
      <span aria-current="page">{t(locale, 'tag.all')}<sup>{posts.length}</sup></span>
      {category.children.map((child) => <a href={localizedPath(buildCategoryPath([...path, child.name]), locale)}>{translateCategoryName(child.name, locale)}<sup>{postsInCategoryPath(allPosts, [...path, child.name]).length}</sup></a>)}
    </nav>}
  </PageIntro>
  <PostYears posts={posts} locale={locale} showCategory={Boolean(category?.children?.length)} />
</div>
