---
import { SeriesNavigation } from '@components/post/SeriesNavigation';
import { SeriesPostList } from '@components/post/SeriesPostList';
import HomeSiderSegmented from '@components/ui/segmented/HomeSiderSegmented';
import { HomeSiderSegmentType, HomeSiderType } from '@constants/enum';
import { getPostSlug } from '@lib/content/locale';
import { getAdjacentSeriesPosts, getSeriesPosts } from '@lib/content/posts';
import { toPostRef, toPostRefs } from '@lib/content/transforms';
import { cn } from '@lib/utils';
import type { BlogPost } from 'types/blog';
import { getLocaleFromUrl } from '@/i18n';
import HomeInfo from './HomeInfo.astro';
import { ScrollProgress } from './ScrollProgress';
import { TableOfContents } from './TableOfContents/index';

interface Props {
  type?: HomeSiderType;
  className?: string;
  isDrawer?: boolean;
  post?: BlogPost;
}

const { type = HomeSiderType.HOME, className, isDrawer = false, post } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const defaultSegmentType = type === HomeSiderType.POST ? HomeSiderSegmentType.DIRECTORY : HomeSiderSegmentType.INFO;

// 获取系列文章（转换为轻量级引用）
const seriesPosts = post && type === HomeSiderType.POST ? toPostRefs(await getSeriesPosts(post, locale)) : [];

// 获取上一篇和下一篇（转换为轻量级引用）
const adjacentPosts =
  post && type === HomeSiderType.POST ? await getAdjacentSeriesPosts(post, locale) : { prevPost: null, nextPost: null };
const prevPost = adjacentPosts.prevPost ? toPostRef(adjacentPosts.prevPost) : null;
const nextPost = adjacentPosts.nextPost ? toPostRef(adjacentPosts.nextPost) : null;
---

<div
  class={cn(
    'page-home-sider shadow-home-sider sticky top-0 tablet:overscroll-none self-start flex min-w-64 max-w-64 flex-col items-stretch tablet:hidden overflow-auto h-screen px-2 scroll-gutter-stable',
    className,
  )}
  transition:name={isDrawer ? 'page-home-sider-drawer' : 'page-home-sider'}
>
  {
    type === HomeSiderType.POST && (
      <HomeSiderSegmented
        client:only="react"
        className="my-4 tablet:mb-0 flex justify-between text-sm/6 w-auto"
        itemClass="grow"
        defaultValue={defaultSegmentType}
      />
    )
  }

  <sider-content
    class="flex-1 overflow-x-hidden overflow-y-auto"
    data-type={type}
    data-default-type={defaultSegmentType}
  >
    <div slot="info" class="sider-slot" data-slot-type="info">
      <HomeInfo className={type === HomeSiderType.HOME ? 'pt-18 md:pt-0' : ''} />
    </div>
    <div slot="directory" class="sider-slot overflow-hidden h-full" data-slot-type="directory">
      {type === HomeSiderType.POST && <TableOfContents client:only="react" enableNumbering={post?.data.tocNumbering ?? true} />}
    </div>
    <div slot="series" class="sider-slot" data-slot-type="series">
      {type === HomeSiderType.POST && <SeriesPostList client:idle posts={seriesPosts} currentPostSlug={post ? getPostSlug(post) : undefined} locale={locale} />}
    </div>
  </sider-content>

  <!-- 内联脚本：在 DOM 解析后立即隐藏不需要的内容，避免闪烁 -->
  <script is:inline data-astro-rerun>
    (function () {
      const container = document.querySelector('sider-content');
      if (!container) return;

      const defaultType = container.getAttribute('data-default-type') || 'info';
      const slots = container.querySelectorAll('.sider-slot');

      slots.forEach((slot) => {
        const slotType = slot.getAttribute('data-slot-type');
        if (slotType !== defaultType) {
          slot.classList.add('hidden');
        }
      });
    })();
  </script>

  {
    type === HomeSiderType.POST && (
      <SeriesNavigation client:load prevPost={prevPost} nextPost={nextPost} className="w-full px-2" locale={locale} />
    )
  }

  <ScrollProgress client:only="react" className="mt-auto w-full rounded-full pt-4" />
</div>

<script>
  import { HomeSiderSegmentType, HomeSiderType } from '@constants/enum';
  import { readMotionLevel } from '@lib/motion-level';
  import { homeSiderSegmentType } from '@store/app';

  const PANEL_ORDER = [HomeSiderSegmentType.INFO, HomeSiderSegmentType.DIRECTORY, HomeSiderSegmentType.SERIES];
  const EASE_OUT_EXPO = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const EASE_IN_QUART = 'cubic-bezier(0.5, 0, 0.75, 0)';
  /** Rows that cascade in on a lively switch: profile blocks and nav buttons, TOC entries, series posts. */
  const CASCADE_ROWS =
    '[data-home-info-container] > :not([data-home-nav]), [data-home-nav] > *, .toc-container > :not([data-toc-rail]), [data-series-list] > *';
  const CASCADE_SPREAD_MS = 180;

  type Frame = { opacity: string; translate: string };

  function frameOf(element: HTMLElement): Frame {
    const style = getComputedStyle(element);
    return { opacity: style.opacity, translate: style.translate };
  }

  /**
   * Shows the sider panel picked in the segmented control. Panels travel along the tab order: the
   * outgoing one drifts away while the incoming one arrives from the side of the chosen tab, and on
   * the lively level its visible rows cascade in. Everything runs as Web Animations, so a second
   * switch mid-flight cancels cleanly and carries on from what is on screen.
   */
  class SiderContent extends HTMLElement {
    private panels = new Map<HomeSiderSegmentType, HTMLElement>();
    private currentType: HomeSiderSegmentType | null = null;
    private animations: Animation[] = [];
    private unsubscribe: (() => void) | null = null;

    connectedCallback() {
      for (const type of PANEL_ORDER) {
        const panel = this.querySelector<HTMLElement>(`[data-slot-type="${type}"]`);
        if (panel) this.panels.set(type, panel);
      }
      if (this.dataset.type === HomeSiderType.HOME) {
        this.show(HomeSiderSegmentType.INFO, false);
        return;
      }
      const initialType = (this.dataset.defaultType as HomeSiderSegmentType) || HomeSiderSegmentType.INFO;
      homeSiderSegmentType.set(initialType);
      this.show(initialType, false);
      this.unsubscribe?.();
      this.unsubscribe = homeSiderSegmentType.listen((value) => this.show(value, true));
    }

    disconnectedCallback() {
      this.unsubscribe?.();
      this.unsubscribe = null;
      this.settle();
    }

    private show(type: HomeSiderSegmentType, animate: boolean) {
      const next = this.panels.get(type);
      const prevType = this.currentType;
      const prev = prevType ? this.panels.get(prevType) : undefined;
      if (!next || next === prev) return;

      const level = readMotionLevel();
      const moving = animate && prevType !== null && level !== 'reduced' && this.getClientRects().length > 0;
      // Read before settle() so an interrupted switch carries on from what is on screen.
      const prevFrame = moving && prev ? frameOf(prev) : null;
      const nextFrame = moving && !next.classList.contains('hidden') ? frameOf(next) : null;
      // Absolutely positioned panels (desktop) cross over; in-flow ones (narrow drawer) swap in place.
      const crossover = prev && prevFrame && this.scrollTop === 0 && getComputedStyle(prev).position === 'absolute';

      this.settle();
      this.currentType = type;
      for (const panel of this.panels.values()) {
        panel.classList.toggle('hidden', panel !== next && !(crossover && panel === prev));
      }
      this.scrollTop = 0;
      if (!moving || prevType === null) return;

      const lively = level === 'lively';
      const direction = Math.sign(PANEL_ORDER.indexOf(type) - PANEL_ORDER.indexOf(prevType)) || 1;
      const travel = (lively ? 16 : 8) * direction;
      const cascade = lively && !nextFrame && !this.closest('#mobile-drawer');
      const delay = crossover ? 60 : 0;

      if (crossover) {
        prev.inert = true;
        const exit = prev.animate([prevFrame, { opacity: '0', translate: `${-travel / 2}px 0` }], {
          duration: 150,
          easing: EASE_IN_QUART,
          fill: 'forwards',
        });
        exit.onfinish = () => {
          prev.classList.add('hidden');
          prev.inert = false;
          exit.cancel();
        };
        this.animations.push(exit);
      }

      const from = nextFrame ?? { opacity: '0', translate: cascade ? 'none' : `${travel}px 0` };
      this.animations.push(
        next.animate([{ ...from, offset: 0 }], {
          duration: cascade ? 260 : 380,
          delay,
          easing: EASE_OUT_EXPO,
          fill: 'backwards',
        }),
      );
      if (cascade) this.cascade(next, travel, delay);
    }

    private cascade(panel: HTMLElement, travel: number, delay: number) {
      const view = this.getBoundingClientRect();
      const rows = [...panel.querySelectorAll<HTMLElement>(CASCADE_ROWS)].filter((row) => {
        const box = row.getBoundingClientRect();
        return box.height > 0 && box.bottom > view.top && box.top < view.bottom;
      });
      const step = Math.min(30, CASCADE_SPREAD_MS / Math.max(rows.length - 1, 1));
      // A lone start keyframe animates toward each row's own resting style (some nav rows rest dimmed).
      // Rows are left to finish on their own, so a quick second switch fades them out mid-glide.
      rows.forEach((row, index) => {
        row.animate([{ opacity: '0', translate: `${travel}px 0`, offset: 0 }], {
          duration: 520,
          delay: delay + 40 + index * step,
          easing: EASE_OUT_EXPO,
          fill: 'backwards',
        });
      });
    }

    private settle() {
      for (const animation of this.animations) animation.cancel();
      this.animations = [];
      const current = this.currentType ? this.panels.get(this.currentType) : undefined;
      for (const panel of this.panels.values()) {
        panel.inert = false;
        panel.classList.toggle('hidden', panel !== current);
      }
    }
  }

  if (!customElements.get('sider-content')) {
    customElements.define('sider-content', SiderContent);
  }
</script>

<style>
  /* 圣诞模式下调整 z-index，让装饰效果正确显示 */
  :global(html.christmas) .page-home-sider {
    z-index: 5;
  }

  /*
   * 页头可见时（未隐藏）侧栏吸顶偏移到页头下方，避免 sticky 内容与固定页头重叠。
   * 页头随下滚隐藏（-translate-y-full）后恢复 top-0，保持原有吸顶状态。
   * 仅桌面宽度生效（>992px）：移动端抽屉内的 sider 不适用。
   */
  @media (width > 992px) {
    :global(body:has(#site-header:not(.-translate-y-full))) .page-home-sider {
      top: 4.25rem;
      height: calc(100vh - 4.25rem);
      transition:
        top 480ms var(--ease-out-expo),
        height 480ms var(--ease-out-expo);
    }
  }

  sider-content {
    position: relative;
  }

  .sider-slot {
    position: absolute;
    top: auto;
    left: 0;
    right: 0;
  }

  @media (768px >= width) {
    .sider-slot {
      position: relative;
    }
  }

  .sider-slot.hidden {
    display: none;
  }
</style>
