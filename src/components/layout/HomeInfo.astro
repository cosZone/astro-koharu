---
import ChristmasHat from '@components/christmas/ChristmasHat.astro';
import type { Router } from '@constants/router';
import { RESERVED_ROUTES } from '@constants/router';
import { christmasConfig, configuredSeriesSlugs, enabledSeriesSlugs, routers, siteConfig } from '@constants/site-config';
import { getAllTags, getCategoryList, getPostCount, getSortedPosts } from '@lib/content';
import { getLqipStyle } from '@lib/lqip';
import { filterNavItems } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath, resolveNavName, stripLocaleFromPath, t } from '@/i18n';
import Social from './Social.astro';

interface Props {
  /** The drawer lays the profile out in a row; the desktop sider stacks it. */
  isDrawer?: boolean;
}

const { isDrawer = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const postCount = await getPostCount(locale);
const { countMap } = await getCategoryList(locale);
const posts = await getSortedPosts(locale);
const tagCount = Object.keys(getAllTags(posts)).length;

const filteredRouters = filterNavItems(routers, configuredSeriesSlugs, enabledSeriesSlugs, RESERVED_ROUTES);
const strippedPath = stripLocaleFromPath(Astro.url.pathname);
const avatar = siteConfig.avatar ?? '/img/avatar.webp';
// Glue each separator to the tag before it, so a wrapped "FE / ACG / INFP" bio never starts a line with "/".
const description = siteConfig.description?.replace(/\s+([/|·])\s+/g, '\u00a0$1 ');

const resolveUrl = (item: Router) =>
  item.path ? (item.localeIndependent ? item.path : localizedPath(item.path, locale)) : item.path;

const stats = [
  { href: localizedPath('/', locale), count: postCount, label: t(locale, 'homeInfo.articles') },
  { href: localizedPath('/categories', locale), count: Object.keys(countMap).length, label: t(locale, 'homeInfo.categories') },
  { href: localizedPath('/tags', locale), count: tagCount, label: t(locale, 'homeInfo.tags') },
];
---

<div class="home-info" data-variant={isDrawer ? 'drawer' : 'sider'} data-home-info-container>
  <div class="home-profile" data-home-profile>
    <div class="home-identity">
      <div
        class="home-avatar"
        style={getLqipStyle(avatar)}
        data-greet-morning={t(locale, 'homeInfo.greetingMorning')}
        data-greet-afternoon={t(locale, 'homeInfo.greetingAfternoon')}
        data-greet-evening={t(locale, 'homeInfo.greetingEvening')}
        data-greet-night={t(locale, 'homeInfo.greetingNight')}
      >
        <img src={avatar} alt={`${siteConfig.name ?? ''} avatar`} loading="eager" fetchpriority="high" />
        {christmasConfig.enabled && christmasConfig.features.christmasHat && <ChristmasHat />}
        <span class="home-greeting" aria-hidden="true"></span>
      </div>
      <div class="home-identity-text">
        <p class="home-name">{siteConfig?.name}</p>
        {description && <p class="home-description" title={siteConfig.description}>{description}</p>}
        <Social />
      </div>
    </div>
    <div class="home-stats">
      {
        stats.map((stat) => (
          <a href={stat.href} class="home-stat">
            <span class="home-stat-count">{stat.count}</span>
            <span class="home-stat-label">{stat.label}</span>
          </a>
        ))
      }
    </div>
  </div>

  <nav class="home-nav" data-home-nav aria-label={t(locale, 'drawer.navMenu')}>
    {
      filteredRouters.map((item) => {
        const displayName = resolveNavName(item.nameKey, item.name, locale);
        if (item.children?.length) {
          const hasCurrent = item.children.some((child) => child.path === strippedPath);
          return (
            <div class="home-nav-group" data-collapsible>
              <button
                class="home-nav-row"
                data-collapse-trigger
                aria-expanded={hasCurrent ? 'true' : 'false'}
                aria-label={t(locale, 'common.menuLabel', { name: displayName })}
                type="button"
              >
                {item.icon && <Icon name={item.icon} class="home-nav-icon" />}
                <span class="home-nav-label">{displayName}</span>
                <Icon name="ri:arrow-down-s-line" class="home-nav-chevron" />
              </button>
              <div class="home-nav-collapse">
                <div class="home-nav-children">
                  {item.children.map((child) => {
                    const isCurrent = child.path === strippedPath;
                    return (
                      <a
                        href={resolveUrl(child)}
                        class="home-nav-child"
                        aria-current={isCurrent ? 'page' : undefined}
                      >
                        {child.icon && <Icon name={child.icon} class="home-nav-icon" />}
                        <span class="home-nav-label">{resolveNavName(child.nameKey, child.name, locale)}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        }
        const isCurrent = item.path === strippedPath;
        return (
          <a href={resolveUrl(item)} class="home-nav-row" aria-current={isCurrent ? 'page' : undefined}>
            {item.icon && <Icon name={item.icon} class="home-nav-icon" />}
            <span class="home-nav-label">{displayName}</span>
          </a>
        );
      })
    }
  </nav>
</div>

<script>
  // Delegated listeners serve every sider copy (desktop and drawer) across page swaps.
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest?.('[data-collapse-trigger]');
    if (!trigger) return;
    trigger.setAttribute('aria-expanded', String(trigger.getAttribute('aria-expanded') !== 'true'));
  });

  /** The greeting follows the visitor's clock, so it is picked at hover time rather than at build time. */
  function greetingKey(hour: number): 'greetMorning' | 'greetAfternoon' | 'greetEvening' | 'greetNight' {
    if (hour >= 5 && hour < 12) return 'greetMorning';
    if (hour >= 12 && hour < 18) return 'greetAfternoon';
    if (hour >= 18 && hour < 23) return 'greetEvening';
    return 'greetNight';
  }

  document.addEventListener('pointerover', (event) => {
    const avatar = (event.target as Element | null)?.closest?.<HTMLElement>('.home-avatar');
    const bubble = avatar?.querySelector<HTMLElement>('.home-greeting');
    if (!avatar || !bubble || avatar.contains(event.relatedTarget as Node | null)) return;
    bubble.textContent = avatar.dataset[greetingKey(new Date().getHours())] ?? '';
  });
</script>
