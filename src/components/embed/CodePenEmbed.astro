---
/**
 * Loads CodePen's embed script on demand and re-runs it after Astro page transitions.
 * https://blog.codepen.io/documentation/embedded-pens/
 */
---

<script>
  declare global {
    interface Window {
      __CPEmbed?: (selector?: string) => void;
    }
  }

  let scriptPromise: Promise<void> | undefined;
  let observer: IntersectionObserver | undefined;

  function loadCodePenScript() {
    if (window.__CPEmbed) return Promise.resolve();
    if (scriptPromise) return scriptPromise;
    scriptPromise = new Promise<void>((resolve, reject) => {

      const script = document.createElement('script');
      script.src = 'https://cpwebassets.codepen.io/assets/embed/ei.js';
      script.async = true;
      script.onload = () => {
        resolve();
      };
      script.onerror = () => {
        scriptPromise = undefined;
        script.remove();
        reject(new Error('CodePen embed script could not be loaded'));
      };
      document.head.appendChild(script);
    });
    return scriptPromise;
  }

  async function renderEmbed(element: Element) {
    observer?.unobserve(element);
    element.setAttribute('data-codepen-ready', 'true');
    try {
      await loadCodePenScript();
      if (element.isConnected) {
        window.__CPEmbed?.('[data-codepen-ready="true"]');
      }
    } catch (error) {
      console.error('[CodePen Embed] Failed to load CodePen embed script:', error);
    }
  }

  function cleanup() {
    observer?.disconnect();
    observer = undefined;
  }

  function initializeCodePenEmbeds() {
    cleanup();
    const elements = document.querySelectorAll('.codepen, .codepen-later');
    // The official script processes every .codepen on load; keep pending pens out of that selector.
    for (const element of elements) {
      element.classList.remove('codepen');
      element.classList.add('codepen-later');
    }
    if (!('IntersectionObserver' in window)) {
      for (const element of elements) void renderEmbed(element);
      return;
    }
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) void renderEmbed(entry.target);
        }
      },
      { rootMargin: '800px' },
    );
    for (const element of elements) observer.observe(element);
  }

  // Initialize on initial page load
  if (document.readyState !== 'loading') {
    initializeCodePenEmbeds();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initializeCodePenEmbeds);
  document.addEventListener('astro:before-swap', cleanup);
</script>
