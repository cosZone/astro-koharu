---
import SakuraSVG from '@components/svg/SakuraSvg';
import { friendGroups, friendsData } from '@constants/friends-config';
import { groupFriendLinks } from '@lib/config/friends';
import { defaultLocale, t } from '@/i18n';
import FriendCard from './FriendCard.astro';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const grouped = friendGroups.length > 0;
const sections = groupFriendLinks(friendsData, friendGroups).map(({ group, friends }) => ({
  id: group?.id ?? 'ungrouped',
  title: group?.title ?? t(locale, 'friends.ungrouped'),
  description: group?.description,
  friends,
}));
---

<div data-friends-grid>
  {friendsData.length === 0 && !grouped ? (
    <div class="flex min-h-40 flex-col items-center justify-center gap-2 text-center">
      <h2 class="font-semibold text-foreground text-lg">{t(locale, 'friends.emptyTitle')}</h2>
      <p class="text-muted-foreground text-sm">{t(locale, 'friends.emptyDesc')}</p>
    </div>
  ) : grouped ? (
    <>
      {/* In-page filter tabs; without JS every group is listed anyway. */}
      <div class="index-tabs friends-group-tabs" role="group" aria-label={t(locale, 'friends.filterLabel')}>
        <button type="button" data-friends-filter="all" aria-pressed="true">{t(locale, 'friends.all')}<sup>{friendsData.length}</sup></button>
        {sections.map((section) => (
          <button type="button" data-friends-filter={section.id} aria-pressed="false">{section.title}<sup>{section.friends.length}</sup></button>
        ))}
      </div>
      {friendsData.length === 0 && <div data-friends-empty class="flex min-h-40 flex-col items-center justify-center gap-2 text-center">
        <h2 class="font-semibold text-foreground text-lg">{t(locale, 'friends.emptyTitle')}</h2>
        <p class="text-muted-foreground text-sm">{t(locale, 'friends.emptyDesc')}</p>
      </div>}
      {sections.map((section) => (
        <section id={`friends-${section.id}`} class="friends-section" data-friends-section={section.id} data-empty={section.friends.length === 0 || undefined} tabindex="-1">
          <h2 class="year-rule friends-section-rule">
            <SakuraSVG className="year-rule-bloom" />
            <span>{section.title}</span>
            <small>{section.friends.length}</small>
          </h2>
          {section.description && <p class="friends-section-desc">{section.description}</p>}
          {section.friends.length > 0 ? (
            <div class="friends-grid grid">
              {section.friends.map((friend) => <FriendCard friend={friend} />)}
            </div>
          ) : (
            <div class="friends-section-empty">
              <p class="font-semibold text-foreground">{t(locale, 'friends.emptyGroupTitle')}</p>
              <p class="text-muted-foreground text-sm">{t(locale, 'friends.emptyGroupDescription')}</p>
            </div>
          )}
        </section>
      ))}
    </>
  ) : (
    <div class="friends-grid grid">
      {friendsData.map((friend) => <FriendCard friend={friend} />)}
    </div>
  )}
</div>

<style>
  .friends-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.875rem;
  }

  .friends-group-tabs {
    margin-bottom: 0.5rem;
  }

  .friends-section {
    scroll-margin-top: 5rem;
  }

  .friends-section + .friends-section {
    margin-top: 2rem;
  }

  /* With every group shown, empty groups add nothing; they appear only when picked in the filter. */
  [data-friends-grid]:not([data-friends-active]) .friends-section[data-empty] {
    display: none;
  }

  [data-friends-active] [data-friends-empty] {
    display: none;
  }

  .friends-section-rule {
    margin-top: 1.25rem;
  }

  .friends-section-desc {
    margin: -0.25rem 0 0.875rem;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }

  .friends-section-rule + .friends-grid,
  .friends-section-rule + .friends-section-empty {
    margin-top: 0.875rem;
  }

  .friends-section-empty {
    display: flex;
    min-height: 8rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    border-radius: 1rem;
    background: color-mix(in oklab, hsl(var(--muted)) 45%, hsl(var(--card)));
    text-align: center;
  }

  @media (max-width: 1199px) {
    .friends-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .friends-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.625rem;
    }
  }
</style>

<script>
  import './friends-interactions';
</script>
