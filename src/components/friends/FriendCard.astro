---
import type { FriendLink } from '@constants/friends-config';
import { normalizeHexColor } from '@lib/utils';
import { Icon } from 'astro-icon/components';

interface Props {
  friend: FriendLink;
}

const { friend } = Astro.props;
---

<a
  href={friend.url}
  target="_blank"
  rel="noopener noreferrer"
  class="friend-card"
  style={{ '--friend-color': friend.color ? normalizeHexColor(friend.color) : 'hsl(var(--primary))' }}
>
  <span class="friend-avatar">
    <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" aria-hidden="true">
      <rect width="100" height="100" fill="hsl(var(--primary))" />
      <g fill="hsl(var(--card))">
        <circle cx="30" cy="45" r="6" />
        <circle cx="70" cy="45" r="6" />
      </g>
      <path d="M 35 65 Q 50 75 65 65" stroke="hsl(var(--card))" stroke-width="4" fill="none" stroke-linecap="round" />
      <g fill="hsl(var(--card))" opacity="0.5">
        <circle cx="20" cy="55" r="6" />
        <circle cx="80" cy="55" r="6" />
      </g>
    </svg>
    {friend.image && <img src={friend.image} alt="" width="56" height="56" loading="lazy" decoding="async" class="relative size-full object-cover" data-friend-avatar />}
  </span>
  <span class="friend-copy">
    <span class="friend-heading">
      <strong class="friend-name">{friend.owner}</strong>
      <span class="friend-site">{friend.site}</span>
    </span>
    <span class="friend-desc">{friend.desc}</span>
  </span>
  <Icon name="ri:arrow-right-up-line" class="friend-arrow" aria-hidden="true" />
</a>

<style>
  /* A name card on a neutral surface: the configured color rings the avatar and floods in on hover. */
  .friend-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    padding: 0.875rem 1rem;
    border-radius: 1rem;
    background: color-mix(in oklab, hsl(var(--muted)) 45%, hsl(var(--card)));
    box-shadow: inset 0 0 0 1px hsl(var(--border) / 0.6);
    color: hsl(var(--foreground));
    transition:
      background-color 240ms ease,
      box-shadow 240ms ease;
  }

  .friend-card:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
  }

  .friend-avatar {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 50%;
    background: hsl(var(--card));
    box-shadow:
      0 0 0 2px hsl(var(--card)),
      0 0 0 3.5px color-mix(in oklab, var(--friend-color) 70%, transparent);
  }

  .friend-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
  }

  .friend-heading {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.5rem;
    padding-right: 1rem;
  }

  .friend-name {
    overflow: hidden;
    flex-shrink: 0;
    max-width: 70%;
    font-size: 0.9375rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 200ms ease;
  }

  .friend-site {
    overflow: hidden;
    min-width: 0;
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .friend-arrow {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    width: 0.875rem;
    height: 0.875rem;
    color: color-mix(in oklab, var(--friend-color) 70%, hsl(var(--foreground)));
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .friend-card:hover {
      background: color-mix(in oklab, var(--friend-color) 10%, hsl(var(--card)));
      box-shadow:
        inset 0 0 0 1px color-mix(in oklab, var(--friend-color) 40%, hsl(var(--border))),
        0 10px 24px -16px color-mix(in oklab, var(--friend-color) 80%, transparent);
    }

    .friend-card:hover .friend-name {
      color: color-mix(in oklab, var(--friend-color) 65%, hsl(var(--foreground)));
    }

    :global(html:not(.dark)) .friend-card:hover .friend-name {
      color: color-mix(in oklab, var(--friend-color) 35%, hsl(var(--foreground)));
    }

    .friend-card:hover .friend-arrow {
      opacity: 1;
    }

    /* Micro-interactions: the avatar leans in as its ring brightens, the arrow slides out of the corner. */
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not([data-motion='reduced'])) .friend-avatar {
        transition:
          transform 420ms cubic-bezier(0.34, 1.4, 0.64, 1),
          box-shadow 240ms ease;
      }

      :global(html:not([data-motion='reduced'])) .friend-arrow {
        transform: translate(-4px, 4px);
        transition:
          transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
          opacity 200ms ease;
      }

      :global(html:not([data-motion='reduced'])) .friend-card:hover .friend-avatar {
        transform: rotate(-8deg) scale(1.06);
        box-shadow:
          0 0 0 2px hsl(var(--card)),
          0 0 0 4px var(--friend-color),
          0 6px 16px -6px color-mix(in oklab, var(--friend-color) 80%, transparent);
      }

      :global(html:not([data-motion='reduced'])) .friend-card:hover .friend-arrow {
        transform: translate(0, 0);
      }
    }
  }

  @media (hover: none) and (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    :global(html:is([data-motion='lively'], [data-motion='subtle'])) .friend-card {
      transition: transform 180ms ease-out;
    }

    :global(html:is([data-motion='lively'], [data-motion='subtle'])) .friend-card:active {
      transform: scale(0.98);
    }
  }
</style>
