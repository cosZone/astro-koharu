---
import type { FriendLink } from '@constants/friends-config';
import { normalizeHexColor } from '@lib/utils';
import { Icon } from 'astro-icon/components';

interface Props {
  friend: FriendLink;
}

const { friend } = Astro.props;
let hostname: string;
try {
  hostname = new URL(friend.url).hostname.replace(/^www\./, '');
} catch {
  hostname = friend.url;
}
---

<a
  href={friend.url}
  target="_blank"
  rel="noopener noreferrer"
  class="friend-card relative flex flex-col overflow-hidden rounded-[1.125rem] bg-card text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
  style={{ '--friend-color': friend.color ? normalizeHexColor(friend.color) : 'hsl(var(--primary))' }}
>
  <!-- The friend's configured color is the card's theme: banner, avatar ring, shadow and hover ink. -->
  <div class="friend-banner" aria-hidden="true"></div>
  <div class="friend-avatar">
    <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" aria-hidden="true">
      <rect width="100" height="100" fill="hsl(var(--primary))" />
      <g fill="hsl(var(--card))">
        <circle cx="30" cy="45" r="6" />
        <circle cx="70" cy="45" r="6" />
      </g>
      <path d="M 35 65 Q 50 75 65 65" stroke="hsl(var(--card))" stroke-width="4" fill="none" stroke-linecap="round" />
      <g fill="hsl(var(--card))" opacity="0.5">
        <circle cx="20" cy="55" r="6" />
        <circle cx="80" cy="55" r="6" />
      </g>
    </svg>
    {friend.image && <img src={friend.image} alt="" width="60" height="60" loading="lazy" decoding="async" class="relative size-full object-cover" data-friend-avatar />}
  </div>
  <div class="flex grow flex-col px-4 pt-2 pb-3.5 text-center">
    <h2 class="friend-name truncate font-bold text-[0.9375rem] leading-6">{friend.owner}</h2>
    <p class="truncate text-muted-foreground text-xs leading-5">{friend.site}</p>
    <p class="mt-2 line-clamp-2 text-[0.8125rem] text-foreground/65 leading-relaxed">{friend.desc}</p>
    <div class="friend-domain mt-auto flex items-center justify-center gap-1 pt-2.5 text-[0.6875rem] text-muted-foreground leading-4">
      <span class="truncate">{hostname}</span>
      <Icon name="ri:external-link-line" class="size-3 shrink-0" aria-hidden="true" />
    </div>
  </div>
</a>

<style>
  .friend-card {
    height: 15rem;
    box-shadow:
      inset 0 0 0 1px hsl(var(--border) / 0.7),
      0 1px 2px hsl(var(--foreground) / 0.04),
      0 10px 24px -14px color-mix(in oklab, var(--friend-color) 70%, transparent);
  }

  .friend-banner {
    position: relative;
    height: 4.25rem;
    flex-shrink: 0;
    overflow: hidden;
    background:
      radial-gradient(120% 140% at 0% 0%, hsl(0 0% 100% / 0.45), transparent 55%),
      linear-gradient(
        160deg,
        color-mix(in oklab, var(--friend-color) 90%, white),
        color-mix(in oklab, var(--friend-color) 55%, hsl(var(--card)))
      );
  }

  /* Fade the band into the card body, and draw a fine highlight along the top edge. */
  .friend-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, transparent 45%, hsl(var(--card) / 0.6) 80%, hsl(var(--card))),
      linear-gradient(to bottom, hsl(0 0% 100% / 0.4), transparent 1px);
  }

  .friend-avatar {
    position: relative;
    z-index: 1;
    width: 3.75rem;
    height: 3.75rem;
    flex-shrink: 0;
    margin: -1.875rem auto 0;
    overflow: hidden;
    border-radius: 50%;
    background: hsl(var(--card));
    box-shadow:
      0 0 0 3px hsl(var(--card)),
      0 0 0 4px color-mix(in oklab, var(--friend-color) 45%, transparent),
      0 6px 14px -6px hsl(0 0% 0% / 0.35);
  }

  .friend-domain {
    border-top: 1px dashed hsl(var(--border));
  }

  :global(html.dark) .friend-banner {
    background: linear-gradient(
      160deg,
      color-mix(in oklab, var(--friend-color) 60%, hsl(var(--card))),
      color-mix(in oklab, var(--friend-color) 25%, hsl(var(--card)))
    );
  }

  :global(html.dark) .friend-card {
    box-shadow:
      inset 0 0 0 1px hsl(var(--border) / 0.8),
      0 10px 24px -16px color-mix(in oklab, var(--friend-color) 55%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .friend-card:hover .friend-name {
      color: color-mix(in oklab, var(--friend-color) 75%, hsl(var(--foreground)));
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(html:not([data-motion='reduced'])) .friend-card {
        transition:
          transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
          box-shadow 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      :global(html:not([data-motion='reduced'])) .friend-avatar {
        transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      :global(html:not([data-motion='reduced'])) .friend-card:hover {
        transform: translateY(-4px);
        box-shadow:
          inset 0 0 0 1px color-mix(in oklab, var(--friend-color) 35%, hsl(var(--border))),
          0 2px 4px hsl(var(--foreground) / 0.04),
          0 18px 32px -16px color-mix(in oklab, var(--friend-color) 80%, transparent);
      }

      :global(html:not([data-motion='reduced'])) .friend-card:hover .friend-avatar {
        transform: scale(1.06);
      }
    }
  }

  @media (hover: none) and (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    :global(html:is([data-motion='lively'], [data-motion='subtle'])) .friend-card {
      transition: transform 180ms ease-out;
    }

    :global(html:is([data-motion='lively'], [data-motion='subtle'])) .friend-card:active {
      transform: scale(0.98);
    }
  }
</style>
