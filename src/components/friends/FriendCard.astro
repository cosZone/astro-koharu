---
import type { FriendLink } from '@constants/friends-config';

interface Props {
  friend: FriendLink;
}

const { friend } = Astro.props;
---

<a
  href={friend.url}
  target="_blank"
  rel="noopener noreferrer"
  class="friend-card relative block overflow-hidden rounded-2xl border border-border bg-card text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
  style={{ '--friend-color': friend.color || 'hsl(var(--primary))' }}
  data-friend-card
>
  <div class="friend-band h-14" aria-hidden="true"></div>
  <div class="friend-avatar absolute top-7 left-1/2 size-14 -translate-x-1/2 overflow-hidden rounded-full border-4 border-card bg-card">
    <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" aria-hidden="true">
      <rect width="100" height="100" fill="hsl(var(--primary))" />
      <g fill="hsl(var(--card))">
        <circle cx="30" cy="45" r="6" />
        <circle cx="70" cy="45" r="6" />
      </g>
      <path d="M 35 65 Q 50 75 65 65" stroke="hsl(var(--card))" stroke-width="4" fill="none" stroke-linecap="round" />
      <g fill="hsl(var(--card))" opacity="0.5">
        <circle cx="20" cy="55" r="6" />
        <circle cx="80" cy="55" r="6" />
      </g>
    </svg>
    {friend.image && <img src={friend.image} alt="" width="56" height="56" loading="lazy" decoding="async" class="relative size-full object-cover" data-friend-avatar />}
  </div>
  <div class="px-3 pt-9 pb-4 text-center">
    <h2 class="truncate font-semibold text-[15px] leading-6">{friend.owner}</h2>
    <p class="mt-0.5 truncate text-muted-foreground text-xs leading-5">{friend.site}</p>
    <p class="mt-2 line-clamp-2 text-[13px] leading-5">{friend.desc}</p>
  </div>
</a>

<style>
  .friend-card {
    height: 218px;
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
  }

  .friend-band {
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--friend-color) 70%, hsl(var(--card))),
      color-mix(in oklab, var(--friend-color) 30%, transparent)
    );
  }

  .friend-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at var(--mx) var(--my),
      color-mix(in oklab, hsl(var(--primary)) 12%, transparent),
      transparent 65%
    );
  }

  @media (hover: hover) and (pointer: fine) {
    .friend-card:hover {
      border-color: color-mix(in oklab, hsl(var(--primary)) 40%, transparent);
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(html[data-motion='lively']) .friend-card {
        transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      :global(html[data-motion='lively']) .friend-card[data-tilting] {
        transform: perspective(800px) rotateX(var(--rx)) rotateY(var(--ry));
      }

      :global(html[data-motion='lively']) .friend-card::after {
        transition: opacity 200ms ease-out;
      }

      :global(html[data-motion='lively']) .friend-card[data-tilting]::after {
        opacity: 1;
      }
    }
  }
</style>
