---
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import MediaGallery from './MediaGallery.astro';
import MessageBody from './MessageBody.astro';
import type { MomentMessageLabels, MomentMessageViewModel } from './types';

interface Props {
  message: MomentMessageViewModel;
  detail?: boolean;
  groupStart?: boolean;
  labels: MomentMessageLabels;
}

const { message, detail = false, groupStart = true, labels } = Astro.props;
const [publishedDate, publishedTimeOfDay] = message.publishedLabel.split(' ');
const railDate = publishedDate?.slice(5);
---

<article
  class={cn('moments-message-card min-w-0', !detail && 'cursor-pointer')}
  data-message-href={!detail ? message.permalink : undefined}
  data-group-start={groupStart ? 'true' : 'false'}
  data-channel-id={message.channel.id}
  data-author-signature={message.authorSignature ?? ''}
  data-published-at={message.publishedAt}
>
  {!detail && (
    <a
      href={message.permalink}
      aria-label={`${labels.permalink}: ${message.publishedLabel}`}
      title={message.publishedLabel}
      class="moments-timeline-time text-muted-foreground hover:text-primary tabular-nums text-xs leading-5"
    >
      <time datetime={message.publishedAt}>
        <span class="block">{railDate}</span>
        <span class="block">{publishedTimeOfDay}</span>
      </time>
    </a>
  )}
  <header class="moments-message-header flex min-w-0 items-start gap-2">
    {groupStart && <div class="moments-message-identity flex min-w-0 grow items-center gap-2">
      <span aria-hidden="true" class="bg-primary/12 text-primary inline-flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold">
        {Array.from((message.authorSignature || message.channel.title).trim())[0] ?? '#'}
      </span>
      <div class="min-w-0">
        <a href={message.channel.href} title={message.channel.title} class="moments-channel-link text-foreground hover:text-primary block truncate text-xs font-medium">
          {message.channel.title}
        </a>
        <div class="text-muted-foreground flex min-w-0 flex-wrap items-center gap-x-2 text-xs">
          {message.channel.username && <span class="truncate">@{message.channel.username}</span>}
          {message.authorSignature && <span class="truncate">{message.authorSignature}</span>}
          {!detail && message.revision > 1 && <span class="bg-muted shrink-0 rounded-full px-1.5 py-0.5 text-[0.6875rem]">{labels.updated}</span>}
        </div>
      </div>
    </div>}
    <div class="moments-message-meta text-muted-foreground flex min-w-0 grow items-center gap-2 text-xs">
      <time datetime={message.publishedAt} class="moments-inline-time tabular-nums" title={message.publishedLabel}>
        {detail ? message.publishedLabel : publishedTimeOfDay}
      </time>
      {message.revision > 1 && <span class="bg-muted rounded-full px-1.5 py-0.5 text-[0.6875rem]">{labels.updated}</span>}
    </div>
    <nav class="moments-message-tools" aria-label={labels.actions}>
      <a href={message.permalink} class="moments-message-tool" aria-label={labels.permalink} title={labels.permalink}>
        <Icon is:inline name="ri:links-line" class="size-3.5" aria-hidden="true" />
      </a>
      <button
        type="button"
        class="moments-copy-link moments-message-tool"
        data-copy-value={message.permalink}
        data-copy-label={labels.copyLink}
        data-copied-label={labels.copied}
        data-copy-failed-label={labels.copyFailed}
        aria-label={labels.copyLink}
        title={labels.copyLink}
      >
        <Icon is:inline name="ri:file-copy-line" class="size-3.5" aria-hidden="true" />
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </button>
      {message.sourceUrl && (
        <a href={message.sourceUrl} target="_blank" rel="noopener noreferrer" class="moments-message-tool" aria-label={labels.viewSource} title={labels.viewSource}>
          <Icon is:inline name="ri:external-link-line" class="size-3.5" aria-hidden="true" />
        </a>
      )}
    </nav>
  </header>

  {(message.html || message.media.length === 0) && (
    <MessageBody
      html={message.html}
      contentId={`moments-message-${message.id}-content`}
      collapsible={!detail}
      emptyLabel={labels.emptyMessage}
      expandLabel={labels.expand}
      collapseLabel={labels.collapse}
      spoilerRevealLabel={labels.revealSpoiler}
    />
  )}

  {message.media.length > 0 && (
    <div class="mt-2.5">
      <MediaGallery
        media={message.media}
        detail={detail}
        showAll={message.showAllMedia}
        labels={{
          processing: labels.mediaProcessing,
          unavailable: labels.mediaUnavailable,
          image: labels.image,
          video: labels.video,
          audio: labels.audio,
          document: labels.document,
          openDocument: labels.openDocument,
          viewSource: labels.viewSource,
          more: labels.mediaMore,
        }}
      />
    </div>
  )}

  {message.tags.length > 0 && (
    <nav aria-label={labels.tags} class="mt-2.5 flex flex-wrap items-center gap-1.5">
      {message.tags.map((tag) => (
        <a
          href={tag.href}
          class="bg-muted/50 text-muted-foreground hover:bg-primary/10 hover:text-primary focus-visible:ring-primary inline-flex min-h-10 items-center rounded-full px-2.5 text-[0.8125rem] focus-visible:ring-2 focus-visible:outline-none"
        >
          {tag.label}
        </a>
      ))}
    </nav>
  )}

</article>

<script>
  const cardInteractiveSelector =
    'a, button, input, select, textarea, summary, video, audio, spoiler-span, [data-static-spoiler], [role="button"], [contenteditable="true"]';
  let lifecycle: AbortController | undefined;
  const statusTimers = new Map<HTMLButtonElement, number>();

  function cleanup() {
    lifecycle?.abort();
    lifecycle = undefined;
    for (const timer of statusTimers.values()) window.clearTimeout(timer);
    statusTimers.clear();
  }

  function installMomentCardLinks(signal: AbortSignal) {
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (!(event.target instanceof Element) || event.target.closest(cardInteractiveSelector)) return;
      const card = event.target.closest<HTMLElement>('.moments-message-card[data-message-href]');
      const selection = window.getSelection();
      if (!card?.dataset.messageHref || (selection && !selection.isCollapsed)) return;
      const url = new URL(card.dataset.messageHref, window.location.href).href;
      if (event.metaKey || event.ctrlKey) window.open(url, '_blank', 'noopener');
      else window.location.assign(url);
    }, { signal });
  }

  function installMomentCopyButtons(signal: AbortSignal) {
    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('.moments-copy-link') : null;
      if (!button) return;
      const status = button.querySelector<HTMLElement>('[data-copy-status]');
      const value = new URL(button.dataset.copyValue ?? window.location.href, window.location.href).href;
      let succeeded = false;
      try {
        await navigator.clipboard.writeText(value);
        succeeded = true;
      } catch {
        if (!signal.aborted) window.prompt(button.dataset.copyFailedLabel ?? '', value);
      }
      if (signal.aborted || !button.isConnected) return;
      const result = (succeeded ? button.dataset.copiedLabel : button.dataset.copyFailedLabel) ?? '';
      if (status) status.textContent = result;
      button.title = result;
      window.clearTimeout(statusTimers.get(button));
      statusTimers.set(button, window.setTimeout(() => {
        if (status) status.textContent = '';
        button.title = button.dataset.copyLabel ?? '';
        statusTimers.delete(button);
      }, 1800));
    }, { signal });
  }

  function init() {
    cleanup();
    if (!document.querySelector('.moments-message-card')) return;
    lifecycle = new AbortController();
    // Delegation also covers cursor pages appended after initialization.
    installMomentCardLinks(lifecycle.signal);
    installMomentCopyButtons(lifecycle.signal);
  }

  if (document.readyState !== 'loading') init();
  document.addEventListener('DOMContentLoaded', init, { once: true });
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>

<style>
  .moments-message-card {
    position: relative;
  }

  .moments-message-header {
    position: relative;
    min-height: 2.5rem;
    padding-inline-end: 7.5rem;
    margin-block-end: 0.625rem;
  }

  .moments-channel-link {
    display: block;
    min-height: 2.5rem;
    padding-block: 0.625rem;
  }

  .moments-message-meta {
    display: none;
    min-height: 2.5rem;
  }

  .moments-message-card[data-group-start='false'] .moments-message-identity {
    display: none;
  }

  .moments-message-card[data-group-start='false'] .moments-message-meta,
  .moments-message-card:not([data-message-href]) .moments-message-meta {
    display: flex;
  }

  .moments-message-card:not([data-message-href]) .moments-message-header {
    flex-wrap: wrap;
  }

  .moments-message-tools {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    display: flex;
  }

  .moments-message-tool {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    border-radius: 9999px;
  }

  .moments-message-tool:hover,
  .moments-message-tool:focus-visible {
    color: hsl(var(--primary));
    background: hsl(var(--muted));
  }

  .moments-message-tool:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .moments-message-tools {
      opacity: 0;
      transition: opacity 150ms ease;
    }

    .moments-message-card:hover .moments-message-tools,
    .moments-message-card:focus-within .moments-message-tools {
      opacity: 1;
    }
  }
</style>
