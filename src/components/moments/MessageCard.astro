---
import { Icon } from 'astro-icon/components';
import MediaGallery from './MediaGallery.astro';
import MessageBody from './MessageBody.astro';
import type { MomentMessageViewModel } from './types';

interface Labels {
  updated: string;
  permalink: string;
  copyLink: string;
  copied: string;
  copyFailed: string;
  viewSource: string;
  emptyMessage: string;
  expand: string;
  collapse: string;
  mediaProcessing: string;
  mediaUnavailable: string;
  image: string;
  video: string;
  audio: string;
  document: string;
  openDocument: string;
  mediaMore: string;
}

interface Props {
  message: MomentMessageViewModel;
  detail?: boolean;
  labels: Labels;
}

const { message, detail = false, labels } = Astro.props;
---

<article class="moments-message-card bg-card min-w-0 rounded-2xl p-5 tablet:rounded-xl tablet:p-4">
  <header class="mb-3 flex flex-wrap items-start justify-between gap-2.5">
    <div class="flex min-w-0 items-center gap-2.5">
      <span aria-hidden="true" class="bg-primary/12 text-primary inline-flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-bold tablet:size-8">
        {Array.from(message.channel.title.trim())[0] ?? '#'}
      </span>
      <div class="min-w-0">
        <a href={message.channel.href} class="hover:text-primary block truncate text-sm leading-snug font-semibold transition-colors">{message.channel.title}</a>
        {message.channel.username && <p class="text-muted-foreground truncate text-xs leading-5">@{message.channel.username}</p>}
      </div>
    </div>
    {message.revision > 1 && <span class="bg-muted/70 text-muted-foreground inline-flex min-h-6 items-center rounded-full px-2 text-[0.6875rem]">{labels.updated}</span>}
  </header>

  <MessageBody
    html={message.html}
    collapsible={!detail}
    emptyLabel={labels.emptyMessage}
    expandLabel={labels.expand}
    collapseLabel={labels.collapse}
  />

  {message.media.length > 0 && (
    <div class="mt-3">
      <MediaGallery
        media={message.media}
        detail={detail}
        sourceUrl={message.sourceUrl}
        labels={{
          processing: labels.mediaProcessing,
          unavailable: labels.mediaUnavailable,
          image: labels.image,
          video: labels.video,
          audio: labels.audio,
          document: labels.document,
          openDocument: labels.openDocument,
          viewSource: labels.viewSource,
          more: labels.mediaMore,
        }}
      />
    </div>
  )}

  <footer class="bg-muted/35 text-muted-foreground mt-3 flex flex-wrap items-center gap-x-1 gap-y-1 rounded-xl px-1.5 py-1 text-xs">
    <a href={message.permalink} class="hover:bg-background/70 hover:text-foreground inline-flex min-h-8 items-center gap-1.5 rounded-lg px-2 transition-[background-color,color]">
      <Icon name="ri:time-line" class="size-4" aria-hidden="true" />
      <time datetime={message.publishedAt} class="tabular-nums">{message.publishedLabel}</time>
    </a>
    <a
      href={message.permalink}
      aria-label={labels.permalink}
      class="hover:bg-background/70 hover:text-foreground inline-flex min-h-8 items-center gap-1.5 rounded-lg px-2 transition-[background-color,color]"
    >
      <Icon name="ri:links-line" class="size-4" aria-hidden="true" />
      <span class="tablet:hidden">{labels.permalink}</span>
    </a>
    <button
      type="button"
      class="moments-copy-link hover:bg-background/70 hover:text-foreground focus-visible:ring-primary inline-flex min-h-8 touch-manipulation items-center gap-1.5 rounded-lg px-2 transition-[background-color,color,scale] active:scale-[0.96] focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:outline-none"
      data-copy-value={message.permalink}
      data-copy-label={labels.copyLink}
      data-copied-label={labels.copied}
      data-copy-failed-label={labels.copyFailed}
      aria-label={labels.copyLink}
    >
      <Icon name="ri:file-copy-line" class="size-4" aria-hidden="true" />
      <span class="tablet:hidden" data-copy-text>{labels.copyLink}</span>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </button>
    {message.sourceUrl && (
      <a
        href={message.sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={labels.viewSource}
        class="hover:bg-background/70 hover:text-foreground inline-flex min-h-8 items-center gap-1.5 rounded-lg px-2 transition-[background-color,color]"
      >
        <Icon name="ri:external-link-line" class="size-4" aria-hidden="true" />
        <span class="tablet:hidden">{labels.viewSource}</span>
      </a>
    )}
  </footer>
</article>

<script>
  function installMomentCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.moments-copy-link:not([data-copy-ready])').forEach((button) => {
      button.dataset.copyReady = 'true';
      button.addEventListener('click', async () => {
        const text = button.querySelector<HTMLElement>('[data-copy-text]');
        const status = button.querySelector<HTMLElement>('[data-copy-status]');
        const value = button.dataset.copyValue ?? window.location.href;
        let succeeded = false;
        try {
          await navigator.clipboard.writeText(new URL(value, window.location.href).href);
          succeeded = true;
        } catch {
          window.prompt(button.dataset.copyFailedLabel ?? '', new URL(value, window.location.href).href);
        }

        const result = succeeded ? button.dataset.copiedLabel : button.dataset.copyFailedLabel;
        if (text) text.textContent = result ?? '';
        if (status) status.textContent = result ?? '';
        window.setTimeout(() => {
          if (text) text.textContent = button.dataset.copyLabel ?? '';
          if (status) status.textContent = '';
        }, 1800);
      });
    });
  }

  installMomentCopyButtons();
  document.addEventListener('astro:page-load', installMomentCopyButtons);
</script>

<style>
  .moments-message-card {
    box-shadow:
      0 0 0 1px hsl(var(--border) / 0.85),
      0 12px 28px -22px rgb(0 0 0 / 0.42);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .moments-message-card {
      transition: box-shadow 150ms ease-out;
    }

    .moments-message-card:hover {
      box-shadow:
        0 0 0 1px hsl(var(--primary) / 0.28),
        0 16px 32px -24px rgb(0 0 0 / 0.48);
    }
  }
</style>
