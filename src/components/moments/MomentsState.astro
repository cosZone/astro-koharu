---
import { Icon } from 'astro-icon/components';

interface Props {
  kind: 'empty' | 'not-found' | 'rate-limited' | 'unavailable' | 'error';
  title: string;
  description?: string;
  retryHref?: string;
  retryLabel?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { kind, title, description, retryHref, retryLabel, actionHref, actionLabel } = Astro.props;
const icon = {
  empty: 'ri:inbox-2-line',
  'not-found': 'ri:question-line',
  'rate-limited': 'ri:timer-line',
  unavailable: 'ri:cloud-off-line',
  error: 'ri:error-warning-line',
}[kind];
---

<section class="bg-muted/25 flex min-h-64 flex-col items-center justify-center rounded-2xl border border-border p-8 text-center" aria-labelledby="moments-state-title">
  <Icon name={icon} class="text-muted-foreground mb-4 size-12" aria-hidden="true" />
  <h2 id="moments-state-title" class="text-xl font-bold">{title}</h2>
  {description && <p class="text-muted-foreground mt-2 max-w-xl text-sm leading-6">{description}</p>}
  {(retryHref || actionHref) && (
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      {retryHref && retryLabel && (
        <a href={retryHref} class="bg-primary hover:bg-primary/85 focus-visible:ring-primary rounded-full px-4 py-2 text-sm font-medium text-white transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none">
          {retryLabel}
        </a>
      )}
      {actionHref && actionLabel && (
        <a href={actionHref} class="border-border bg-card hover:border-primary/50 hover:text-primary focus-visible:ring-primary rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none">
          {actionLabel}
        </a>
      )}
    </div>
  )}
</section>
