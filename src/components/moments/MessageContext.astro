---
import { Icon } from 'astro-icon/components';
import type { MomentContextItemViewModel } from './types';

interface Props {
  newer?: MomentContextItemViewModel | null;
  older?: MomentContextItemViewModel | null;
  newerLabel: string;
  olderLabel: string;
  mediaMessageLabel: string;
  emptyMessageLabel: string;
  navigationLabel: string;
}

const { newer, older, newerLabel, olderLabel, mediaMessageLabel, emptyMessageLabel, navigationLabel } = Astro.props;
const fallbackPreview = (item: MomentContextItemViewModel) => item.preview?.trim() || mediaMessageLabel || emptyMessageLabel;
---

{
  (newer || older) && (
    <nav aria-label={navigationLabel} class="grid grid-cols-2 gap-3 tablet:grid-cols-1">
      {newer ? (
        <a
          href={newer.href}
          rel="prev"
          class="border-border bg-card hover:border-primary/50 focus-visible:ring-primary group min-w-0 rounded-2xl border p-4 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          <span class="text-primary flex items-center gap-1 text-xs font-medium">
            <Icon name="ri:arrow-left-line" aria-hidden="true" />
            {newerLabel}
          </span>
          <span class="mt-2 block truncate text-sm font-medium group-hover:underline">{fallbackPreview(newer)}</span>
          <time datetime={newer.publishedAt} class="text-muted-foreground mt-1 block text-xs">{newer.publishedLabel}</time>
        </a>
      ) : (
        <span />
      )}
      {older && (
        <a
          href={older.href}
          rel="next"
          class="border-border bg-card hover:border-primary/50 focus-visible:ring-primary group min-w-0 rounded-2xl border p-4 text-right transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          <span class="text-primary flex items-center justify-end gap-1 text-xs font-medium">
            {olderLabel}
            <Icon name="ri:arrow-right-line" aria-hidden="true" />
          </span>
          <span class="mt-2 block truncate text-sm font-medium group-hover:underline">{fallbackPreview(older)}</span>
          <time datetime={older.publishedAt} class="text-muted-foreground mt-1 block text-xs">{older.publishedLabel}</time>
        </a>
      )}
    </nav>
  )
}
