---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { cn } from '@lib/utils';

interface Props {
  title: string;
  className?: string;
}

const { title, className } = Astro.props;
---

<TwoColumnLayout showPostFooter={false}>
  <Cover slot="cover" title={title} compact />
  <HomeSider slot="sider" />
  <section
    class={cn(
      'moments-panel shadow-box bg-gradient-start mx-0 flex w-full min-w-0 flex-col gap-3 px-6 py-5 tablet:gap-2.5 tablet:px-4 tablet:py-4',
      className,
    )}
  >
    <slot />
  </section>
</TwoColumnLayout>

<style>
  :global(.moments-timeline) {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.moments-timeline-time) {
    display: none;
  }

  @media (min-width: 993px) {
    /* All panel content shares one leading edge; only timeline furniture
       (time, dots, rail) hangs in the reserved margin. */
    .moments-panel {
      padding-inline-start: 8rem;
    }

    /* The search form uses the reserved margin instead of sharing the feed edge. */
    :global(.moments-fullbleed) {
      margin-inline-start: -6.5rem;
    }

    :global(.moments-inline-time) {
      display: none;
    }

    :global(.moments-timeline) {
      position: relative;
    }

    :global(.moments-timeline)::before {
      position: absolute;
      inset-block: 0.5rem;
      inset-inline-start: -20px;
      width: 1px;
      content: '';
      background: hsl(var(--foreground) / 0.14);
    }

    :global(.moments-timeline > li) {
      position: relative;
    }

    :global(.moments-timeline > li)::before {
      position: absolute;
      top: 0.45rem;
      inset-inline-start: -24px;
      width: 9px;
      height: 9px;
      content: '';
      background: hsl(var(--primary));
      border-radius: 9999px;
      box-shadow: 0 0 0 4px hsl(var(--primary) / 0.15);
    }

    :global(.moments-timeline-time) {
      position: absolute;
      top: 0.15rem;
      inset-inline-start: -7.25rem;
      display: block;
      width: 5.5rem;
      text-align: end;
    }
  }
</style>
