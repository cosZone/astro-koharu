---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { cn } from '@lib/utils';

interface Props {
  title: string;
  className?: string;
}

const { title, className } = Astro.props;
---

<TwoColumnLayout showPostFooter={false}>
  <Cover slot="cover" title={title} compact />
  <HomeSider slot="sider" />
  <section
    class={cn(
      'shadow-box bg-gradient-start mx-0 flex w-full min-w-0 flex-col gap-3 px-6 py-5 tablet:gap-2.5 tablet:px-4 tablet:py-4',
      className,
    )}
  >
    <slot />
  </section>
</TwoColumnLayout>
