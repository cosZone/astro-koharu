---
import { Icon } from 'astro-icon/components';
import SearchFilters from './SearchFilters';
import type { MomentChannelViewModel } from './types';

interface Props {
  action: string;
  query?: string;
  channels?: MomentChannelViewModel[];
  selectedChannelId?: string;
  sort?: 'relevance' | 'newest';
  showHint?: boolean;
  showFilters?: boolean;
  labels: {
    form: string;
    query: string;
    placeholder: string;
    channel: string;
    allChannels: string;
    sort: string;
    relevance: string;
    newest: string;
    submit: string;
    hint: string;
  };
}

const {
  action,
  query = '',
  channels = [],
  selectedChannelId = '',
  sort = 'relevance',
  labels,
  showHint = true,
  showFilters = true,
} = Astro.props;
---

<form action={action} method="get" role="search" aria-label={labels.form} class="grid gap-3">
  <div class="flex gap-2">
    <label class="min-w-0 grow">
      <span class="sr-only">{labels.query}</span>
      <span class="border-border/80 bg-background focus-within:border-primary focus-within:ring-primary/20 flex items-center gap-2 rounded-full border px-3 transition-[border-color,box-shadow] focus-within:ring-2">
        <Icon name="ri:search-line" class="text-muted-foreground shrink-0" aria-hidden="true" />
        <input
          type="search"
          name="q"
          value={query}
          minlength="3"
          maxlength="200"
          required
          autocomplete="off"
          placeholder={labels.placeholder}
          class="min-w-0 grow bg-transparent py-2.5 text-base outline-none desktop:text-sm"
        />
        <button
          type="submit"
          aria-label={labels.submit}
          class="text-muted-foreground hover:text-primary focus-visible:ring-primary hidden min-h-8 min-w-8 shrink-0 touch-manipulation items-center justify-center rounded-full transition-colors focus-visible:ring-2 focus-visible:outline-none tablet:inline-flex"
        >
          <Icon name="ri:arrow-right-line" class="size-4" aria-hidden="true" />
        </button>
      </span>
    </label>
    <button
      type="submit"
      class="bg-primary hover:bg-primary/85 focus-visible:ring-primary min-h-10 touch-manipulation rounded-full px-5 py-2 text-sm font-medium text-white transition-[background-color,scale] active:scale-[0.96] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none tablet:hidden"
    >
      {labels.submit}
    </button>
  </div>
  {showHint && <p class="text-muted-foreground text-xs">{labels.hint}</p>}
  {showFilters && (
    <div class="grid grid-cols-2 gap-2" data-native-filters>
      <label class="grid gap-1 text-sm">
        <span class="text-muted-foreground text-xs">{labels.channel}</span>
        <select name="channel" class="border-border/80 bg-background focus:border-primary focus:ring-primary/20 min-h-9 w-full min-w-0 rounded-lg border px-2.5 py-1.5 outline-none focus:ring-2">
          <option value="" selected={!selectedChannelId}>{labels.allChannels}</option>
          {channels.map((channel) => (
            <option value={channel.id} selected={channel.id === selectedChannelId}>{channel.title}</option>
          ))}
        </select>
      </label>
      <label class="grid gap-1 text-sm">
        <span class="text-muted-foreground text-xs">{labels.sort}</span>
        <select name="sort" class="border-border/80 bg-background focus:border-primary focus:ring-primary/20 min-h-9 w-full min-w-0 rounded-lg border px-2.5 py-1.5 outline-none focus:ring-2">
          <option value="relevance" selected={sort === 'relevance'}>{labels.relevance}</option>
          <option value="newest" selected={sort === 'newest'}>{labels.newest}</option>
        </select>
      </label>
    </div>
  )}
</form>
{showFilters && (
  <SearchFilters
    client:load
    action={action}
    query={query}
    channels={channels.map((channel) => ({ value: channel.id, label: channel.title }))}
    selectedChannelId={selectedChannelId}
    sort={sort}
    labels={{
      channel: labels.channel,
      allChannels: labels.allChannels,
      sort: labels.sort,
      relevance: labels.relevance,
      newest: labels.newest,
    }}
  />
)}
