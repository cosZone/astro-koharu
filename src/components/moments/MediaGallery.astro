---
import MediaAttachment from './MediaAttachment.astro';
import type { MomentMediaViewModel } from './types';

interface Labels {
  processing: string;
  unavailable: string;
  image: string;
  video: string;
  audio: string;
  document: string;
  openDocument: string;
  viewSource: string;
  more: string;
}

interface Props {
  media: MomentMediaViewModel[];
  detail?: boolean;
  showAll?: boolean;
  labels: Labels;
}

const { media, detail = false, showAll = false, labels } = Astro.props;
const visible = detail || showAll ? media : media.slice(0, 4);
const remaining = Math.max(0, media.length - visible.length);
const columns = visible.length === 1 ? 'grid-cols-1' : 'grid-cols-2';
---

{
  visible.length > 0 && (
    <moments-media-gallery class={`relative grid ${columns} gap-2`}>
      {visible.map((attachment, index) => (
        <div class:list={['relative min-w-0', visible.length === 3 && index === 0 ? 'col-span-2' : '']}>
          <MediaAttachment media={attachment} sourceUrl={attachment.sourceUrl} labels={labels} />
          {remaining > 0 && index === visible.length - 1 && (
            <span
              class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-lg bg-black/60 text-2xl font-bold text-white"
              aria-label={labels.more.replace('{count}', String(remaining))}
            >
              +{remaining}
            </span>
          )}
        </div>
      ))}
    </moments-media-gallery>
  )
}

<script>
  class MomentsMediaGallery extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;
      this.dataset.initialized = 'true';
      this.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest<HTMLButtonElement>('[data-media-image]');
        if (!button) return;

        const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-media-image]'));
        const images = buttons.map((item) => ({
          src: item.dataset.originalSrc ?? '',
          alt: item.dataset.alt ?? '',
        }));
        const currentIndex = buttons.indexOf(button);
        window.dispatchEvent(
          new CustomEvent('open-image-lightbox', {
            detail: {
              ...images[currentIndex],
              images,
              currentIndex,
            },
          }),
        );
      });
    }
  }

  if (!customElements.get('moments-media-gallery')) {
    customElements.define('moments-media-gallery', MomentsMediaGallery);
  }
</script>
