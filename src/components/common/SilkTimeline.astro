---
import { PETAL_MASK } from '@lib/sakura/petal';
import { cn } from '@lib/utils';
import '@/styles/components/silk-timeline.css';

interface Props {
  id?: string;
  className?: string;
}
const { id, className } = Astro.props;
---
<div id={id} class={cn('silk-timeline', className)} data-silk-timeline style={{ '--petal-mask': PETAL_MASK }}>
  <span class="silk-petal" aria-hidden="true"></span>
  <slot />
</div>
<script>
  import { setupSilkTimelines } from '@lib/silk-timeline';
  setupSilkTimelines();
</script>
