---
import ColophonMeta from '@components/post/colophon/ColophonMeta.astro';
import { Routes } from '@constants/router';
import { createArticleStatsConfig, motionConfig, siteConfig } from '@constants/site-config';
import { colophonItemsAt } from '@lib/content/colophon';
import { getPostSlug } from '@lib/content/locale';
import { getPostColophon } from '@lib/content/post-colophon';
import { getPostReadingTime } from '@lib/content/posts';
import { displayDate } from '@lib/date';
import { getLqipStyle } from '@lib/lqip';
import { postTitleMorphName } from '@lib/morph-transitions';
import { routeBuilder } from '@lib/route';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import UmamiPVSpan from '@/components/umami/UmamiPVSpan';
import { MAX_WIDTH } from '@/constants/layout';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import SakuraPetals from './SakuraPetals.astro';
import WaveSvg from './wave';

export interface CoverProps {
  data?: BlogPost;
  title?: string;
  /** Utility pages can opt into a shorter cover with a neutral loading surface. */
  compact?: boolean;
}

const { data, title, compact = false } = Astro.props as CoverProps;

const { date, updated, title: dataTitle, draft } = data?.data ?? {};

const readState = data ? getPostReadingTime(data) : null;
const isDraft = import.meta.env.DEV && draft === true;

// 获取横幅图片的 LQIP 样式
const bannerLqipStyle = compact ? undefined : getLqipStyle('/img/site_header_1920.webp');

const locale = getLocaleFromUrl(Astro.url.pathname);

const href = data && localizedPath(routeBuilder(Routes.Post, data), locale);

const pageStatsConfig = href ? createArticleStatsConfig(href) : null;
const metaMarks = data ? colophonItemsAt(getPostColophon(data, locale), 'meta') : [];
const titleMorph = data ? postTitleMorphName(getPostSlug(data)) : undefined;
const copyLinkLabel = t(locale, 'cover.copyLink');
const copiedLabel = t(locale, 'common.copied');
const copyFailedLabel = t(locale, 'common.copyFailed');
---

<div
  class:list={[
    'cover-hero relative z-0 flex overflow-hidden',
    compact ? 'h-[42svh] min-h-72 max-h-120 tablet:h-[36svh] tablet:min-h-64' : 'h-[60svh] max-h-200',
  ]}
>
  <div class="cover-scrim absolute inset-0 h-full"></div>
  {motionConfig.heroPetals && <SakuraPetals />}
  <div
    class:list={[
      'cover-copy absolute inset-0 flex flex-col items-center justify-center px-5 text-white',
      compact ? 'bottom-[4svh]' : 'bottom-[8svh]',
    ]}
  >
    {
      title ? (
        <h1
          class:list={[
            'motion-rise shadow-text word-break flex items-center gap-2 text-center font-bold text-balance',
            MAX_WIDTH.content,
            compact
              ? 'text-4xl/[1.15] tracking-[0.08em] tablet:text-3xl/[1.15] tablet:tracking-[0.05em]'
              : 'text-5xl/[1.2] tracking-widest',
          ]}
        >
          {title}
          <button
            type="button"
            class="cover-copy-link hover:text-primary inline-flex cursor-pointer items-center rounded-full p-1 transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            aria-label={copyLinkLabel}
            title={copyLinkLabel}
            data-copy-label={copyLinkLabel}
            data-copied-label={copiedLabel}
            data-copy-failed-label={copyFailedLabel}
          >
            <Icon name="ri:link" class={compact ? 'size-7 tablet:size-6' : undefined} aria-hidden="true" />
            <span class="sr-only" aria-live="polite"></span>
          </button>
        </h1>
      ) : data ? (
        <>
          <h1
            class={`motion-rise shadow-text word-break text-4.5xl text-center font-bold md:text-2xl ${MAX_WIDTH.content} flex flex-wrap items-center justify-center gap-3`}
            transition:name={titleMorph}
            transition:animate="initial"
            data-morph={titleMorph}
          >
            {dataTitle ?? title}
            {isDraft && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-yellow-500 px-3 py-1.5 text-base font-semibold text-white shadow-lg backdrop-blur-sm text-shadow-none hover:bg-yellow-500 md:px-2.5 md:py-1 md:text-sm">
                <Icon name="fa6-solid:file-pen" class="h-4 w-4 md:h-3.5 md:w-3.5" />
                {t(locale, 'post.draft')}
              </span>
            )}
          </h1>
          {data && (
            <p class="motion-rise mt-3 flex flex-wrap items-center justify-center gap-4 md:text-xs" style="--i: 1">
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:calendar-days" />
                {t(locale, "post.publishedAt", { date: date ? displayDate.datetime(date) : '' })}
              </span>
              {updated && (
                <span class="flex items-center gap-1">
                  <Icon name="fa6-solid:calendar-days" />
                  {t(locale, "post.updatedAt", { date: displayDate.datetime(updated) })}
                </span>
              )}
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:pen-nib" /> {t(locale, "post.wordCount", { count: readState?.words ?? 0 })}
              </span>
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:clock" />
                {readState?.text}
              </span>
              {pageStatsConfig && (
                <span class="flex items-center gap-1">
                  <Icon name="ri:eye-line" class="h-4 w-4" />
                  <UmamiPVSpan client:idle statsConfig={pageStatsConfig} />
                  {t(locale, 'stats.pageviews')}
                </span>
              )}
              {metaMarks.length > 0 && <ColophonMeta items={metaMarks} />}
            </p>
          )}
        </>
      ) : (
        <>
          <h2 class="motion-rise shadow-text font-chill-round text-5xl/[1.2]">{siteConfig?.alternate}</h2>
          <h1 class="motion-rise shadow-text font-chill-round mt-3 text-5xl/[1.2] font-bold tracking-widest" style="--i: 1">
            {siteConfig?.title}
          </h1>
          <p class="motion-rise shadow-text mt-5 text-sm tracking-[0.2em]" style="--i: 2">= {siteConfig?.subtitle} =</p>
        </>
      )
    }
  </div>
  <div
    class:list={['relative -z-10 h-full min-h-60 w-full', compact && 'bg-card']}
    transition:persist="page-cover-banner"
    id="banner-box"
    style={bannerLqipStyle}
  >
    <img
      src="/img/site_header_1920.webp"
      alt="cover"
      class="h-full w-full object-cover"
      sizes="50vw"
      srcset="/img/site_header_800.webp 800w,/img/site_header_1920.webp 1200w"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <WaveSvg />
</div>

<script>
  import { readMotionLevel, subscribeMotionLevel } from '@lib/motion-level';

  /**
   * First visit only: the banner fades up from its LQIP and settles from a slight zoom.
   * A cached banner is painted before this module runs, so animating it would visibly jump.
   */
  function settleBanner() {
    const image = document.querySelector<HTMLImageElement>('#banner-box > img');
    if (!image || image.complete || readMotionLevel() === 'reduced') return;
    image.addEventListener(
      'load',
      () => {
        if (readMotionLevel() === 'reduced') return;
        const easing = 'cubic-bezier(0.25, 1, 0.5, 1)';
        const animations = [
          image.animate({ opacity: [0, 1] }, { duration: 700, easing }),
          image.animate({ scale: [1.08, 1] }, { duration: 1800, easing }),
        ];
        const unsubscribe = subscribeMotionLevel(() => {
          if (readMotionLevel() === 'reduced') animations.forEach((animation) => animation.cancel());
        });
        void Promise.allSettled(animations.map((animation) => animation.finished)).then(unsubscribe);
      },
      { once: true },
    );
  }

  function installCoverCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.cover-copy-link:not([data-copy-ready])').forEach((button) => {
      button.dataset.copyReady = 'true';
      button.addEventListener('click', async () => {
        const value = window.location.href;
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          window.prompt(button.dataset.copyFailedLabel ?? button.dataset.copyLabel ?? '', value);
          return;
        }

        const status = button.querySelector<HTMLElement>('[aria-live]');
        if (status) status.textContent = button.dataset.copiedLabel ?? '';
        button.title = button.dataset.copiedLabel ?? button.title;
        window.setTimeout(() => {
          if (status) status.textContent = '';
          button.title = button.dataset.copyLabel ?? button.title;
        }, 1800);
      });
    });
  }

  settleBanner();
  installCoverCopyButtons();
  document.addEventListener('astro:page-load', installCoverCopyButtons);
</script>
