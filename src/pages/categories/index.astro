---
import CategoryList from '@components/category/CategoryList.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getCategoryLinks, getCategoryList } from '@lib/content';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

// Root pages render the default locale; `[lang]/` mirrors pass their locale in explicitly.
const { locale = defaultLocale } = Astro.props;
const { categories, countMap } = await getCategoryList(locale);
const links = getCategoryLinks(categories, '');
---

<Layout locale={locale} title={`${t(locale, 'category.allCategories')} | ${seoConfig.title}`}>
  <TwoColumnLayout>
    <Cover slot="cover" title={t(locale, 'category.allCategories')} />
    <HomeSider slot="sider" />
    <CategoryList categories={categories} countMap={countMap} totalCount={links.length ?? 0} />
  </TwoColumnLayout>
</Layout>
