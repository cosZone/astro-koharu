---
import CategoryList from '@components/category/CategoryList.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { seoConfig } from '@constants/site-config';
import { Layout, TwoColumnLayout } from '@layouts/index';
import { getCategoryLinks, getCategoryList, getSortedPosts } from '@lib/content';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

// Root pages render the default locale; `[lang]/` mirrors pass their locale in explicitly.
const { locale = defaultLocale } = Astro.props;
const { categories } = await getCategoryList(locale);
const links = getCategoryLinks(categories, '');
const posts = await getSortedPosts(locale);
---

<Layout articleTools={false} locale={locale} title={`${t(locale, 'category.allCategories')} | ${seoConfig.title}`}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover compact slot="cover" title={t(locale, 'category.allCategories')} />
    <HomeSider slot="sider" />
    <CategoryList categories={categories} posts={posts} totalCount={links.length} locale={locale} />
  </TwoColumnLayout>
</Layout>
