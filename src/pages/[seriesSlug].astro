---
import PageIntro from '@components/common/PageIntro.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import PostList from '@components/post/PostList.astro';
import SeriesCover from '@components/ui/cover/SeriesCover.astro';
import { siteConfig } from '@constants/site-config';
import { Layout, TwoColumnLayout } from '@layouts/index';
import type { FeaturedSeriesItem } from '@lib/config/types';
import { getPostsByCategory, translateSeriesField } from '@lib/content';
import { toPostCardDataList } from '@lib/content/transforms';
import { t } from '@/i18n';
import { seriesRoute } from './_shared/routes';

export const getStaticPaths = seriesRoute.root;

interface Props {
  series: FeaturedSeriesItem;
  locale: string;
}

const { series, locale } = Astro.props;

// Get all posts for this series (transform to card data)
const seriesPosts = series.categoryName
  ? toPostCardDataList(await getPostsByCategory(series.categoryName, locale), locale)
  : [];

const seriesFullName = translateSeriesField(series.slug, 'fullName', series.fullName, locale);
const seriesLabel = translateSeriesField(series.slug, 'label', series.label, locale);
const pageTitle = `${seriesFullName || seriesLabel || series.categoryName} | ${siteConfig.title}`;
---

<Layout articleTools={false} locale={locale} title={pageTitle} description={series.description?.slice(0, 160)}>
  <TwoColumnLayout showPostFooter={false}>
    <SeriesCover slot="cover" series={series} />
    <HomeSider slot="sider" />
    <div class="index-surface shadow-box">
      <PageIntro stats={[{ value: seriesPosts.length, label: t(locale, 'index.posts') }]} />
      <PostList posts={seriesPosts} showPaginator={false} isSimple={true} />
    </div>
  </TwoColumnLayout>
</Layout>
