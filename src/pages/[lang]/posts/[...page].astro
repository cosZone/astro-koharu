---
import type { Page } from 'astro';
import type { BlogPost } from 'types/blog';
import { postListRoute } from '../../_shared/routes';
import PostListPage from '../../posts/[...page].astro';

export const getStaticPaths = postListRoute.mirror;

interface Props {
  page: Page<BlogPost>;
  locale: string;
}

const { page, locale } = Astro.props;
---
<PostListPage page={page} locale={locale} />
