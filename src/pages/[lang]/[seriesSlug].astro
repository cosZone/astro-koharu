---
import type { FeaturedSeriesItem } from '@lib/config/types';
import { seriesRoute } from '../_shared/routes';
import SeriesPage from '../[seriesSlug].astro';

export const getStaticPaths = seriesRoute.mirror;

interface Props {
  series: FeaturedSeriesItem;
  locale: string;
}

const { series, locale } = Astro.props;
---
<SeriesPage series={series} locale={locale} />
