# Use two DNS records that already point to this server. Do not include a scheme or path.
BLOG_DOMAIN=blog.example.com
SUITE_DOMAIN=suite.example.com
ACME_EMAIL=you@example.com

# Pin released versions. Do not use main, latest, preview, or a moving minor tag in production.
ASTRO_KOHARU_VERSION=6.1.0
KOHARU_IMAGE=ghcr.io/coszone/koharu-suite:0.3.1

POSTGRES_DB=koharu
POSTGRES_USER=koharu
POSTGRES_PASSWORD=replace-with-a-unique-high-entropy-password
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters

TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_WORKER_CONCURRENCY=4

# The beginner stack keeps a bounded 5 GiB local media cache. S3 is an advanced option.
MEDIA_CACHE_ENABLED=true
MEDIA_CACHE_MAX_BYTES=5368709120
MEDIA_CACHE_DOWNLOAD_CONCURRENCY=2

# Astro fetches suite data on the server, so browser CORS is not needed for this stack.
PUBLIC_CORS_ORIGINS=
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
